{
  "schema": "wbg4.lane-config.v1",
  "lane": "WBG4-SCORR",
  "lane_name": "Strike-conditioned structural corridor (SSCC)",
  "created_utc": "2026-10-28",
  "method_paragraph": "Hide-and-recover on whole fault components with a 3 px buffer, spatially blocked 2x2 quadrants; every catalogue-derived feature is rebuilt from visible components only; a gradient-boosted model over public USGS-derived geophysical layers (GeoDAWN radiometrics + derivative extensions, lidar scarp morphology, SGMC fault geometry) plus visible-fault geometry predicts the withheld faults; the emitted raster is the model probability field thresholded at the DTI-optimal operating point and written as a dense corridor field, never as dots copied or jittered from another submission.",
  "grid": {
    "height": 3730,
    "width": 3292,
    "epsg": 32611,
    "transform": [100.0, 0.0, 243350.0, 0.0, -100.0, 4508550.0],
    "resolution_m": 100.0,
    "footprint_cells": 5167373
  },
  "metric": {
    "alpha": 0.2,
    "beta": 0.8,
    "radius_px": 3,
    "radius_m": 300,
    "source": "https://www.drivendata.org/competitions/306/competition-doe-gems/page/967/"
  },
  "holdout": {
    "buffer_px": 3,
    "folds": 4,
    "blocking": "2x2 contiguous quadrants of the footprint; whole connected fault components assigned by centroid",
    "evaluator": "wbg4-hide-recover-v1 (src/wbg4/lane.py + src/wbg3/metric.py)",
    "negatives_per_positive": 5
  },
